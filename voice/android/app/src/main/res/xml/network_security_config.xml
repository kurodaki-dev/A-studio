<?xml version="1.0" encoding="utf-8"?>
<!-- VOICEVOX engines usually run on a computer of the same Wi-Fi without TLS
     (http://192.168.x.x:50021), so plain HTTP must be allowed. The page itself only
     connects to the engine address the user typed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
