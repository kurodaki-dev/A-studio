{
  "type": "astudio-plugin",
  "kind": "instrument",
  "id": "chip-lead",
  "name": "Chip Lead",
  "version": "1.0.0",
  "author": "A Studio",
  "category": "synth",
  "gain": 0.1,
  "oscillators": [
