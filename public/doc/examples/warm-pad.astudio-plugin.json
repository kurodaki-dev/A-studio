{
  "type": "astudio-plugin",
  "kind": "instrument",
  "id": "warm-pad",
  "name": "Warm Pad",
  "version": "1.0.0",
  "author": "A Studio",
  "category": "synth",
  "gain": 0.12,
  "oscillators": [
    { "wave": "sawtooth", "detune": -9, "gain": 0.5 },
    { "wave": "sawtooth", "detune": 9, "gain": 0.5 },
    { "wave": "triangle", "octave": -1, "gain": 0.4 }
  ],
  "envelope": { "attack": 0.5, "decay": 1.0, "sustain": 0.85, "release": 1.2 },
  "filter": { "type": "lowpass", "cutoff": 1400, "q": 0.8, "envAmount": 800, "envDecay": 1.5 },
  "lfo": { "target": "pitch", "rate": 0.4, "depth": 6 }
}
